# Copy to .env.local. Both values are public (safe in the browser); row-level security protects the data.
# Test (staging) project: Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Email (optional): credit note approvals now, invoices later. Leave unset and nothing is emailed.
# Server-only secrets: set them in Vercel > Project > Settings > Environment Variables, never in the browser.
# EMAIL_FROM must be on a domain verified in Resend (resend.com > Domains), e.g. Jet Worldwide <accounts@jetworldwide.com.au>
RESEND_API_KEY=
EMAIL_FROM=
